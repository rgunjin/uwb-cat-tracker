CompileFlags:
  Compiler: /opt/zephyr-sdk-1.0.1/gnu/arm-zephyr-eabi/bin/arm-zephyr-eabi-gcc
  Add:
    # Both role branches visible to the LSP regardless of which
    # build directory compile_commands.json points at.
    - -DCONFIG_UWB_ROLE_INITIATOR=1
    - -DCONFIG_UWB_ROLE_RESPONDER=1
    - -DCONFIG_UWB_DUMP_INFO=1
  Remove:
    - -fno-printf-return-value
    - -mfp16-format=*
    - -fno-reorder-functions
    - -fno-defer-pop
    - --param=*
    - -mno-fdpic
