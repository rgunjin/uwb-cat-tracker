menu "UWB cat tracker"

choice
    prompt "Node role"
    default UWB_ROLE_INITIATOR

config UWB_ROLE_INITIATOR
    bool "Initiator - sends poll, waits for response"

config UWB_ROLE_RESPONDER
    bool "Responder - waits for poll, replies"

endchoice

config UWB_DUMP_INFO
    bool "Print OTP calibration data at startup"
    default n
    help
        Reads PART_ID, LOT_ID, crystal trim, antenna delay and TX
	    power from OTP and prints them. Used to fill in
	    docs/modules.md when a new module is added.

endmenu

source "Kconfig.zephyr"
